generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  currency     String   @default("USD")
  theme        String   @default("dark")
  onboarded    Boolean  @default(false)
  createdAt    DateTime @default(now())

  accounts          Account[]
  transactions      Transaction[]
  budgets           Budget[]
  goals             Goal[]
  snapshots         NetWorthSnapshot[]
  recurring         RecurringTransaction[]
  categories        Category[]
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  balance   Float    @default(0)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurring    RecurringTransaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  amount      Float
  type        String
  category    String
  description String
  date        DateTime
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  limit     Float
  month     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NetWorthSnapshot {
  id     String   @id @default(cuid())
  userId String
  date   DateTime
  value  Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model RecurringTransaction {
  id            String   @id @default(cuid())
  userId        String
  accountId     String
  amount        Float
  type          String
  category      String
  description   String
  frequency     String
  nextRunDate   DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Category {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String
  icon   String
  kind   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}
