generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  currency     String   @default("USD")
  theme        String   @default("dark")
  onboarded    Boolean  @default(false)
  createdAt    DateTime @default(now())

  xp                 Int       @default(0)
  currentLoginStreak Int       @default(0)
  longestLoginStreak Int       @default(0)
  lastLoginAt        DateTime?
  notifyOnOpponentContribution Boolean @default(true)
  defaultStakeAccountId        String?

  achievements      UserAchievement[]
  accounts          Account[]
  transactions      Transaction[]
  budgets           Budget[]
  goals             Goal[]
  snapshots         NetWorthSnapshot[]
  recurring         RecurringTransaction[]
  categories        Category[]
  notifications     Notification[]
  holdings          Holding[]
  auditLogs         AuditLog[]
  apiTokens         ApiToken[]
  rules             Rule[]
  goalContributions GoalContribution[]
  duelsCreated      Duel[]             @relation("DuelCreator")
  duelPlayers       DuelPlayer[]
}

model Duel {
  id                       String    @id @default(cuid())
  creatorUserId            String
  title                    String
  goalId                   String?
  targetAmount             Float
  sprintLengthDays         Int
  startDate                DateTime
  endDate                  DateTime
  status                   String    @default("PENDING")
  stakeText                String
  stakeAmount              Float?
  stakePercentCap          Int?      @default(10)
  isPractice               Boolean   @default(false)
  autoPenaltyEnabled       Boolean   @default(false)
  stakeVoided              Boolean   @default(false)
  stakeResolvedAt          DateTime?
  dailyCap                 Float     @default(500)
  practiceOpponentDailyAvg Float?
  createdAt                DateTime  @default(now())
  completedAt              DateTime?

  creator User         @relation("DuelCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  players DuelPlayer[]
  sprints Sprint[]
  cheers  Cheer[]
  events  DuelEvent[]

  @@index([creatorUserId, status])
}

model DuelPlayer {
  id                String    @id @default(cuid())
  duelId            String
  userId            String?
  inviteEmail       String?
  side              String
  accepted          Boolean   @default(false)
  declined          Boolean   @default(false)
  stakeAccountId    String?
  totalPoints       Float     @default(0)
  sprintsWon        Int       @default(0)
  currentStreakDays Int       @default(0)
  longestStreakDays Int       @default(0)
  joinedAt          DateTime?

  duel          Duel           @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  contributions Contribution[]
  sprintTargets SprintTarget[]
  cheers        Cheer[]

  @@unique([duelId, side])
  @@index([userId])
}

model Sprint {
  id              String    @id @default(cuid())
  duelId          String
  weekNumber      Int
  startDate       DateTime
  endDate         DateTime
  status          String    @default("ACTIVE")
  themeMultiplier Float     @default(1.0)
  themeLabel      String?
  winnerPlayerId  String?
  closedAt        DateTime?

  duel          Duel           @relation(fields: [duelId], references: [id], onDelete: Cascade)
  targets       SprintTarget[]
  contributions Contribution[]

  @@unique([duelId, weekNumber])
  @@index([duelId, startDate])
}

model SprintTarget {
  id       String   @id @default(cuid())
  sprintId String
  playerId String
  amount   Float
  setAt    DateTime @default(now())

  sprint Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  player DuelPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sprintId, playerId])
}

model Contribution {
  id            String   @id @default(cuid())
  sprintId      String
  playerId      String
  amount        Float
  note          String?
  pointsAwarded Float    @default(0)
  disputeStatus String?
  editableUntil DateTime
  createdAt     DateTime @default(now())

  sprint  Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  player  DuelPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  dispute Dispute?

  @@index([sprintId, playerId])
  @@index([sprintId, createdAt])
}

model Dispute {
  id               String    @id @default(cuid())
  contributionId   String    @unique
  raisedByPlayerId String
  reason           String?
  status           String    @default("PENDING")
  resolvedAt       DateTime?
  autoResolveAt    DateTime
  createdAt        DateTime  @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
}

model Cheer {
  id           String   @id @default(cuid())
  duelId       String
  fromPlayerId String
  sticker      String
  createdAt    DateTime @default(now())

  duel       Duel       @relation(fields: [duelId], references: [id], onDelete: Cascade)
  fromPlayer DuelPlayer @relation(fields: [fromPlayerId], references: [id], onDelete: Cascade)

  @@index([duelId, createdAt])
}

model DuelEvent {
  id        String   @id @default(cuid())
  duelId    String
  kind      String
  playerId  String?
  payload   Json?
  createdAt DateTime @default(now())

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@index([duelId, createdAt])
}

model Rule {
  id         String   @id @default(cuid())
  userId     String
  name       String
  pattern    String
  accountId  String?
  categoryOut String
  autoTag    String?
  priority   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
}

model GoalContribution {
  id            String   @id @default(cuid())
  userId        String
  goalId        String
  amount        Float
  date          DateTime
  transactionId String?
  note          String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String
  link      String?
  key       String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@unique([userId, key])
}

model Holding {
  id         String   @id @default(cuid())
  userId     String
  accountId  String
  symbol     String
  shares     Float
  costBasis  Float
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriceQuote {
  symbol String   @id
  price  Float
  asOf   DateTime
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  balance   Float    @default(0)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurring    RecurringTransaction[]
  holdings     Holding[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  amount      Float
  type        String
  category    String
  description String
  date        DateTime
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  limit     Float
  month     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NetWorthSnapshot {
  id     String   @id @default(cuid())
  userId String
  date   DateTime
  value  Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model RecurringTransaction {
  id            String   @id @default(cuid())
  userId        String
  accountId     String
  amount        Float
  type          String
  category      String
  description   String
  frequency     String
  nextRunDate   DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  xp          Int
  category    String
  tier        Int    @default(1)
}

model UserAchievement {
  id              String   @id @default(cuid())
  userId          String
  achievementSlug String
  unlockedAt      DateTime @default(now())
  progress        Float    @default(0)
  completed       Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementSlug])
  @@index([userId])
}

model Category {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String
  icon   String
  kind   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}
