generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  name         String
  currency     String   @default("USD")
  theme        String   @default("dark")
  onboarded    Boolean  @default(false)
  createdAt    DateTime @default(now())

  xp                 Int       @default(0)
  currentLoginStreak Int       @default(0)
  longestLoginStreak Int       @default(0)
  lastLoginAt        DateTime?
  notifyOnOpponentContribution Boolean @default(true)
  defaultStakeAccountId        String?

  achievements      UserAchievement[]
  accounts          Account[]
  transactions      Transaction[]
  budgets           Budget[]
  goals             Goal[]
  snapshots         NetWorthSnapshot[]
  recurring         RecurringTransaction[]
  categories        Category[]
  notifications     Notification[]
  holdings          Holding[]
  auditLogs         AuditLog[]
  apiTokens         ApiToken[]
  rules             Rule[]
  goalContributions GoalContribution[]
  duelsCreated      Duel[]             @relation("DuelCreator")
  duelPlayers       DuelPlayer[]

  purchaseReviewMutedCategories String[] @default([])

  households                HouseholdMember[]
  purchaseReviewsRequested  PurchaseReview[]   @relation("ReviewRequester")
  purchaseReviewsApproving  PurchaseReview[]   @relation("ReviewApprover")
  pactSignatures            PactSignature[]

  walletEntriesOwned  WalletEntry[] @relation("WalletOwner")
  walletEntriesIssued WalletEntry[] @relation("WalletIssuer")
  confessions         Confession[]
  redemptions         Redemption[]

  squadsCreated     Squad[]             @relation("SquadCreator")
  squadMemberships  SquadMember[]
  squadContributions SquadContribution[]

  gamePlays GamePlay[]

  referralCode      String?    @unique
  referralsMade     Referral[] @relation("ReferralReferrer")
  referralReceived  Referral?  @relation("ReferralReferred")

  predictions Prediction[]

  viceTaxes ViceTax[]
  weeklyRecaps WeeklyRecap[]
  goalRaids    GoalRaid[]
  moneyMindResponses MoneyMindResponse[]
  categoryOverrides CategoryOverride[]

  choreCompletions           ChoreCompletion[]
  loansLent                  Loan[]                      @relation("LoansLent")
  loansBorrowed               Loan[]                      @relation("LoansBorrowed")
  householdGoalContributions HouseholdGoalContribution[]
  householdGoalVotes         HouseholdGoalVote[]
  cheersSent                 HouseholdCheer[]            @relation("CheersSent")
  cheersReceived             HouseholdCheer[]            @relation("CheersReceived")
  capturePatterns   CapturePattern[]
}

model ViceTax {
  id         String   @id @default(cuid())
  userId     String
  category   String
  mode       String   @default("PERCENT")
  rate       Float
  goalId     String
  enabled    Boolean  @default(true)
  taxedTotal Float    @default(0)
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId, enabled])
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  month     String
  category  String
  forecast  Float
  actual    Float?
  accuracy  Float?
  xpAwarded Int      @default(0)
  scAwarded Int      @default(0)
  settledAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, category])
  @@index([userId, month])
}

model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String?   @unique
  code        String
  status      String    @default("PENDING")
  convertedAt DateTime?
  createdAt   DateTime  @default(now())

  referrer User  @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User? @relation("ReferralReferred", fields: [referredId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([code])
}

model Squad {
  id          String   @id @default(cuid())
  name        String
  emoji       String   @default("🎯")
  createdById String
  inviteCode  String   @unique
  visibility  String   @default("PRIVATE")
  createdAt   DateTime @default(now())

  creator User          @relation("SquadCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members SquadMember[]
  quests  SquadQuest[]
}

model SquadMember {
  id       String   @id @default(cuid())
  squadId  String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([userId])
}

model SquadQuest {
  id           String   @id @default(cuid())
  squadId      String
  title        String
  description  String?
  mode         String   @default("COOP")
  targetAmount Float
  deadline     DateTime
  status       String   @default("ACTIVE")
  createdById  String
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  squad         Squad               @relation(fields: [squadId], references: [id], onDelete: Cascade)
  contributions SquadContribution[]

  @@index([squadId, status])
}

model SquadContribution {
  id        String   @id @default(cuid())
  questId   String
  userId    String
  amount    Float
  note      String?
  createdAt DateTime @default(now())

  quest SquadQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questId, userId])
  @@index([questId, createdAt])
}

model WalletEntry {
  id          String   @id @default(cuid())
  userId      String
  currency    String
  delta       Int
  reason      String
  refType     String?
  refId       String?
  fromUserId  String?
  householdId String?
  meta        Json?
  createdAt   DateTime @default(now())

  user User  @relation("WalletOwner", fields: [userId], references: [id], onDelete: Cascade)
  from User? @relation("WalletIssuer", fields: [fromUserId], references: [id], onDelete: SetNull)

  @@index([userId, currency, createdAt])
  @@index([householdId, createdAt])
}

model Confession {
  id            String   @id @default(cuid())
  userId        String
  householdId   String?
  transactionId String?
  amount        Float
  category      String
  note          String?
  partnerSeen   Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([householdId, createdAt])
}

model MarketplaceItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  currency    String
  cost        Int
  category    String
  active      Boolean  @default(true)
  payload     Json?
  createdAt   DateTime @default(now())

  redemptions Redemption[]
}

model Redemption {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  cost      Int
  currency  String
  status    String   @default("REDEEMED")
  meta      Json?
  createdAt DateTime @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  item MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Household {
  id            String    @id @default(cuid())
  name          String
  createdById   String
  pactSignedAt  DateTime?
  createdAt     DateTime  @default(now())

  // The zone the household actually lives in. Every "today" in Household HQ
  // — the shared streak, whether a chore is due, when Daily Objectives reset,
  // when the at-risk nudge fires — is computed against this rather than the
  // server clock, which is UTC in production. See lib/time.ts.
  timezone String @default("UTC")

  // Billing — see lib/plans.ts for the plan catalog and lib/billing.ts for
  // the Stripe integration. "free" is the default for every household that
  // predates billing.
  plan                 String    @default("free") // free | rhythm | household_hq
  planUpdatedAt        DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  planRenewsAt         DateTime?
  planCanceledAt       DateTime?

  members         HouseholdMember[]
  accountShares   AccountShare[]
  pact            Pact?
  moneyDates      MoneyDate[]
  purchaseReviews PurchaseReview[]
  allowances      AllowanceLedger[]
  sharedBills     SharedBill[]
  billCharges     BillCharge[]
  ledgerEntries   LedgerEntry[]
  settlements     Settlement[]
  gameSessions    GameSession[]
  goalRaids       GoalRaid[]
  moneyMindRounds MoneyMindRound[]

  chores       Chore[]
  loans        Loan[]
  householdGoals HouseholdGoal[]
  cheers       HouseholdCheer[]
}

// ---------------------------------------------------------------------------
// Debt Sucker: Household HQ
//
// Three linked systems that turn running a household into a shared game:
//   - Chore + ChoreCompletion  → who actually does the dishes, gamified (Crowns + XP)
//   - Loan + LoanPayment       → "become the bank": track what family members
//                                 loan each other, for what, with interest if any
//   - HouseholdGoal + friends  → pool money for shared purchases (elective, e.g. a
//                                 PS5 or a pool — decided by vote) and essential,
//                                 easy-to-neglect big-ticket items (e.g. a bathroom
//                                 remodel) that get flagged when nobody's funding them
// ---------------------------------------------------------------------------

model Chore {
  id          String   @id @default(cuid())
  householdId String
  name        String
  emoji       String   @default("🧹")
  description String?
  frequency   String   @default("DAILY") // DAILY | WEEKLY | ONEOFF
  category    String   @default("ESSENTIAL") // ESSENTIAL | ELECTIVE
  crownValue  Int      @default(10)
  xpValue     Int      @default(5)
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  completions ChoreCompletion[]

  @@index([householdId, active])
}

model ChoreCompletion {
  id            String   @id @default(cuid())
  choreId       String
  householdId   String
  userId        String
  note          String?
  crownsAwarded Int      @default(0)
  xpAwarded     Int      @default(0)
  completedAt   DateTime @default(now())

  chore Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([householdId, completedAt])
  @@index([userId, completedAt])
  @@index([choreId, completedAt])
}

model Loan {
  id               String    @id @default(cuid())
  householdId      String
  lenderUserId     String
  borrowerUserId   String
  principal        Float
  balanceRemaining Float
  interestRateApr  Float     @default(0)
  purpose          String
  category         String    @default("ELECTIVE") // ESSENTIAL | ELECTIVE
  status           String    @default("ACTIVE") // ACTIVE | PAID | FORGIVEN
  dueDate          DateTime?
  lastAccruedAt    DateTime  @default(now())
  createdAt        DateTime  @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  lender    User          @relation("LoansLent", fields: [lenderUserId], references: [id], onDelete: Cascade)
  borrower  User          @relation("LoansBorrowed", fields: [borrowerUserId], references: [id], onDelete: Cascade)
  payments  LoanPayment[]

  @@index([householdId, status])
  @@index([borrowerUserId, status])
  @@index([lenderUserId, status])
}

model LoanPayment {
  id        String   @id @default(cuid())
  loanId    String
  amount    Float
  note      String?
  createdAt DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, createdAt])
}

model HouseholdGoal {
  id                 String    @id @default(cuid())
  householdId        String
  name               String
  emoji              String    @default("🎯")
  description        String?
  targetAmount       Float
  currentAmount      Float     @default(0)
  category           String    @default("ELECTIVE") // ESSENTIAL | ELECTIVE
  status             String    @default("ACTIVE") // ACTIVE | FUNDED | ARCHIVED
  deadline           DateTime?
  createdById        String
  lastContributionAt DateTime?
  createdAt          DateTime  @default(now())

  household     Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  contributions HouseholdGoalContribution[]
  votes         HouseholdGoalVote[]

  @@index([householdId, status])
}

model HouseholdGoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  amount    Float
  source    String   @default("CASH") // CASH | CROWNS
  note      String?
  createdAt DateTime @default(now())

  goal HouseholdGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

model HouseholdGoalVote {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  createdAt DateTime @default(now())

  goal HouseholdGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([goalId, userId])
}

// Daily engagement: a lightweight reaction between household members —
// "thanks for doing the dishes," "nice streak" — something to do even on a
// day with no chores due. Also one of the three Daily Objectives.
model HouseholdCheer {
  id          String   @id @default(cuid())
  householdId String
  fromUserId  String
  toUserId    String
  emoji       String   @default("👏")
  message     String?
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  from      User      @relation("CheersSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  to        User      @relation("CheersReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@index([toUserId, createdAt])
}

// A short-timeframe, high-intensity goal reframed as a named raid boss with
// narrative stages. Optionally shared with a household so couples raid together.
model GoalRaid {
  id            String   @id @default(cuid())
  userId        String
  householdId   String?
  goalId        String   @unique
  bossName      String
  bossTitle     String
  theme         String   @default("DRAGON")
  lore          String
  startAt       DateTime @default(now())
  deadline      DateTime
  targetAmount  Float
  startAmount   Float    @default(0)
  status        String   @default("ACTIVE") // ACTIVE | DEFEATED | EXPIRED
  defeatedAt    DateTime?
  lastStage     Int      @default(0)
  createdAt     DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household?  @relation(fields: [householdId], references: [id], onDelete: SetNull)
  goal      Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([householdId, status])
}

// Couples financial-alignment game. Each partner answers privately; results
// are revealed together to surface real positions and conversation gaps.
model MoneyMindRound {
  id          String   @id @default(cuid())
  householdId String
  createdById String
  status      String   @default("OPEN") // OPEN | REVEALED
  promptSet   String   @default("CORE")
  revealedAt  DateTime?
  createdAt   DateTime @default(now())

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  responses MoneyMindResponse[]

  @@index([householdId, status])
}

model MoneyMindResponse {
  id        String   @id @default(cuid())
  roundId   String
  userId    String
  answers   Json     // { promptId: { value: number, note?: string } }
  submitted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  round MoneyMindRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
}

model GameSession {
  id          String   @id @default(cuid())
  householdId String
  game        String
  status      String   @default("OPEN")
  config      Json?
  createdById String
  createdAt   DateTime @default(now())
  completedAt DateTime?

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  plays     GamePlay[]

  @@index([householdId, status])
}

model GamePlay {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  answers   Json
  score     Float?
  createdAt DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model SharedBill {
  id            String   @id @default(cuid())
  householdId   String
  name          String
  amount        Float
  frequency     String   // ONEOFF|MONTHLY|WEEKLY|BIWEEKLY|YEARLY
  nextDueDate   DateTime
  accountId     String?
  splitMode     String   // EQUAL|PERCENT|INCOME_RATIO|FIXED
  splitConfig   Json
  categoryName  String   @default("Bills & Utilities")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  charges   BillCharge[]

  @@index([householdId, active])
}

model BillCharge {
  id            String   @id @default(cuid())
  sharedBillId  String
  householdId   String
  paidByUserId  String?
  amount        Float
  dueDate       DateTime
  status        String   @default("UPCOMING") // UPCOMING|PAID|MISSED
  paidAt        DateTime?
  transactionId String?
  createdAt     DateTime @default(now())

  sharedBill SharedBill @relation(fields: [sharedBillId], references: [id], onDelete: Cascade)
  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ledger     LedgerEntry[]

  @@index([householdId, status, dueDate])
  @@unique([sharedBillId, dueDate])
}

model LedgerEntry {
  id            String   @id @default(cuid())
  householdId   String
  fromUserId    String
  toUserId      String
  amount        Float
  reason        String
  billChargeId  String?
  settlementId  String?
  createdAt     DateTime @default(now())

  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  billCharge  BillCharge? @relation(fields: [billChargeId], references: [id], onDelete: SetNull)
  settlement  Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
}

model Settlement {
  id            String   @id @default(cuid())
  householdId   String
  fromUserId    String
  toUserId      String
  amount        Float
  transactionId String?
  note          String?
  settledAt     DateTime @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]

  @@index([householdId, settledAt])
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String?
  role        String    @default("MEMBER")
  joinedAt    DateTime?
  inviteEmail String?
  accepted    Boolean   @default(false)
  declined    Boolean   @default(false)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@unique([householdId, inviteEmail])
  @@index([userId])
}

model AccountShare {
  id           String   @id @default(cuid())
  householdId  String
  accountId    String
  ownerUserId  String
  level        String   @default("HIDDEN")
  updatedAt    DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([householdId, accountId])
  @@index([householdId])
}

model Pact {
  id                    String   @id @default(cuid())
  householdId           String   @unique
  version               Int      @default(1)
  bigPurchaseThreshold  Float    @default(250)
  emergencyFundFloor    Float    @default(0)
  savingsRateMin        Int      @default(0)
  personalAllowanceA    Float    @default(0)
  personalAllowanceB    Float    @default(0)
  requireDualSignOff    Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  household  Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  signatures PactSignature[]
}

model PactSignature {
  id       String   @id @default(cuid())
  pactId   String
  userId   String
  version  Int
  signedAt DateTime @default(now())

  pact Pact @relation(fields: [pactId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pactId, userId, version])
}

model MoneyDate {
  id           String    @id @default(cuid())
  householdId  String
  scheduledAt  DateTime
  durationMin  Int       @default(30)
  cadence      String    @default("WEEKLY")
  status       String    @default("UPCOMING")
  agenda       Json?
  completedAt  DateTime?
  decisions    Json?
  createdAt    DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, scheduledAt])
}

model PurchaseReview {
  id              String    @id @default(cuid())
  householdId     String
  transactionId   String    @unique
  requesterUserId String
  amount          Float
  approverUserId  String
  status          String    @default("PENDING")
  reason          String?
  decidedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  requester  User      @relation("ReviewRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  approver   User      @relation("ReviewApprover", fields: [approverUserId], references: [id], onDelete: Cascade)

  @@index([householdId, status])
}

model AllowanceLedger {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  month       String
  allocated   Float
  spent       Float    @default(0)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId, month])
}

model Duel {
  id                       String    @id @default(cuid())
  creatorUserId            String
  title                    String
  mode                     String    @default("DUEL")
  goalId                   String?
  targetAmount             Float
  sprintLengthDays         Int
  startDate                DateTime
  endDate                  DateTime
  status                   String    @default("PENDING")
  stakeText                String
  stakeAmount              Float?
  stakePercentCap          Int?      @default(10)
  isPractice               Boolean   @default(false)
  autoPenaltyEnabled       Boolean   @default(false)
  stakeVoided              Boolean   @default(false)
  stakeResolvedAt          DateTime?
  dailyCap                 Float     @default(500)
  practiceOpponentDailyAvg Float?
  createdAt                DateTime  @default(now())
  completedAt              DateTime?

  creator User         @relation("DuelCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  players DuelPlayer[]
  sprints Sprint[]
  cheers  Cheer[]
  events  DuelEvent[]

  @@index([creatorUserId, status])
}

model DuelPlayer {
  id                String    @id @default(cuid())
  duelId            String
  userId            String?
  inviteEmail       String?
  side              String
  accepted          Boolean   @default(false)
  declined          Boolean   @default(false)
  stakeAccountId    String?
  totalPoints       Float     @default(0)
  sprintsWon        Int       @default(0)
  currentStreakDays Int       @default(0)
  longestStreakDays Int       @default(0)
  joinedAt          DateTime?

  duel          Duel           @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  contributions Contribution[]
  sprintTargets SprintTarget[]
  cheers        Cheer[]

  @@unique([duelId, side])
  @@index([userId])
}

model Sprint {
  id              String    @id @default(cuid())
  duelId          String
  weekNumber      Int
  startDate       DateTime
  endDate         DateTime
  status          String    @default("ACTIVE")
  themeMultiplier Float     @default(1.0)
  themeLabel      String?
  winnerPlayerId  String?
  closedAt        DateTime?

  duel          Duel           @relation(fields: [duelId], references: [id], onDelete: Cascade)
  targets       SprintTarget[]
  contributions Contribution[]

  @@unique([duelId, weekNumber])
  @@index([duelId, startDate])
}

model SprintTarget {
  id       String   @id @default(cuid())
  sprintId String
  playerId String
  amount   Float
  setAt    DateTime @default(now())

  sprint Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  player DuelPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sprintId, playerId])
}

model Contribution {
  id            String   @id @default(cuid())
  sprintId      String
  playerId      String
  amount        Float
  note          String?
  pointsAwarded Float    @default(0)
  disputeStatus String?
  editableUntil DateTime
  createdAt     DateTime @default(now())

  sprint  Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  player  DuelPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  dispute Dispute?

  @@index([sprintId, playerId])
  @@index([sprintId, createdAt])
}

model Dispute {
  id               String    @id @default(cuid())
  contributionId   String    @unique
  raisedByPlayerId String
  reason           String?
  status           String    @default("PENDING")
  resolvedAt       DateTime?
  autoResolveAt    DateTime
  createdAt        DateTime  @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
}

model Cheer {
  id           String   @id @default(cuid())
  duelId       String
  fromPlayerId String
  sticker      String
  createdAt    DateTime @default(now())

  duel       Duel       @relation(fields: [duelId], references: [id], onDelete: Cascade)
  fromPlayer DuelPlayer @relation(fields: [fromPlayerId], references: [id], onDelete: Cascade)

  @@index([duelId, createdAt])
}

model DuelEvent {
  id        String   @id @default(cuid())
  duelId    String
  kind      String
  playerId  String?
  payload   Json?
  createdAt DateTime @default(now())

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@index([duelId, createdAt])
}

model Rule {
  id         String   @id @default(cuid())
  userId     String
  name       String
  pattern    String
  accountId  String?
  categoryOut String
  autoTag    String?
  priority   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
}

model GoalContribution {
  id            String   @id @default(cuid())
  userId        String
  goalId        String
  amount        Float
  date          DateTime
  transactionId String?
  viceTaxId     String?
  note          String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
  @@index([transactionId])
}

model WeeklyRecap {
  id            String   @id @default(cuid())
  userId        String
  weekStart     DateTime
  weekEnd       DateTime
  income        Float
  spend         Float
  net           Float
  topCategory   String?
  topCategorySpend Float?
  biggestTxAmount Float?
  biggestTxDescription String?
  txCount       Int
  viceTaxFunneled Float
  debtPaid      Float
  bossesDefeated Int
  netWorthDelta Float
  achievementsUnlocked Int
  highlights    Json
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String
  link      String?
  key       String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@unique([userId, key])
}

model Holding {
  id         String   @id @default(cuid())
  userId     String
  accountId  String
  symbol     String
  shares     Float
  costBasis  Float
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriceQuote {
  symbol String   @id
  price  Float
  asOf   DateTime
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  balance   Float    @default(0)
  createdAt DateTime @default(now())

  interestRate Float?
  lastInterestAccruedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurring    RecurringTransaction[]
  holdings     Holding[]
  shares       AccountShare[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  amount      Float
  type        String
  category    String
  description String
  date        DateTime
  pending     Boolean  @default(false)
  reviewId    String?
  createdAt   DateTime @default(now())

  // Capture-engine fields (docs/capture-engine/SPEC.md)
  rawDescription     String?
  categoryConfidence Float?
  visibility         String  @default("personal") // personal | shared
  source             String  @default("manual")   // manual | quick_capture | voice | receipt_scan | import

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// Capture engine: a user's personal correction memory. When they fix a
// category guess, the keyword→category mapping is stored here and takes
// priority over the shipped dictionary from then on.
model CategoryOverride {
  id        String   @id @default(cuid())
  userId    String
  keyword   String   // normalized token, e.g. "starbucks"
  kind      String   // expense | income
  category  String   // app category label
  hitCount  Int      @default(1)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, keyword])
  @@index([userId, kind])
}

// Capture engine: recurring one-tap patterns. After the same rough
// amount + description repeats, we offer to save it; from then on
// logging payday (or the usual grocery run) is a single tap.
model CapturePattern {
  id          String    @id @default(cuid())
  userId      String
  kind        String    // expense | income
  description String
  amount      Float
  category    String
  timesUsed   Int       @default(0)
  confirmed   Boolean   @default(false) // false = suggested, awaiting user accept
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, confirmed])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  limit     Float
  month     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime
  createdAt     DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  viceTaxes ViceTax[]
  raid      GoalRaid?
}

model NetWorthSnapshot {
  id     String   @id @default(cuid())
  userId String
  date   DateTime
  value  Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model RecurringTransaction {
  id            String   @id @default(cuid())
  userId        String
  accountId     String
  amount        Float
  type          String
  category      String
  description   String
  frequency     String
  nextRunDate   DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  xp          Int
  category    String
  tier        Int    @default(1)
}

model UserAchievement {
  id              String   @id @default(cuid())
  userId          String
  achievementSlug String
  unlockedAt      DateTime @default(now())
  progress        Float    @default(0)
  completed       Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementSlug])
  @@index([userId])
}

model Category {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String
  icon   String
  kind   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}
