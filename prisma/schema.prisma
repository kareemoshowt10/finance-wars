generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  currency     String   @default("USD")
  theme        String   @default("dark")
  onboarded    Boolean  @default(false)
  createdAt    DateTime @default(now())

  xp                 Int       @default(0)
  currentLoginStreak Int       @default(0)
  longestLoginStreak Int       @default(0)
  lastLoginAt        DateTime?
  notifyOnOpponentContribution Boolean @default(true)
  defaultStakeAccountId        String?

  achievements      UserAchievement[]
  accounts          Account[]
  transactions      Transaction[]
  budgets           Budget[]
  goals             Goal[]
  snapshots         NetWorthSnapshot[]
  recurring         RecurringTransaction[]
  categories        Category[]
  notifications     Notification[]
  holdings          Holding[]
  auditLogs         AuditLog[]
  apiTokens         ApiToken[]
  rules             Rule[]
  goalContributions GoalContribution[]
  duelsCreated      Duel[]             @relation("DuelCreator")
  duelPlayers       DuelPlayer[]

  purchaseReviewMutedCategories String[] @default([])

  households                HouseholdMember[]
  purchaseReviewsRequested  PurchaseReview[]   @relation("ReviewRequester")
  purchaseReviewsApproving  PurchaseReview[]   @relation("ReviewApprover")
  pactSignatures            PactSignature[]
}

model Household {
  id            String    @id @default(cuid())
  name          String
  createdById   String
  pactSignedAt  DateTime?
  createdAt     DateTime  @default(now())

  members         HouseholdMember[]
  accountShares   AccountShare[]
  pact            Pact?
  moneyDates      MoneyDate[]
  purchaseReviews PurchaseReview[]
  allowances      AllowanceLedger[]
  sharedBills     SharedBill[]
  billCharges     BillCharge[]
  ledgerEntries   LedgerEntry[]
  settlements     Settlement[]
}

model SharedBill {
  id            String   @id @default(cuid())
  householdId   String
  name          String
  amount        Float
  frequency     String   // ONEOFF|MONTHLY|WEEKLY|BIWEEKLY|YEARLY
  nextDueDate   DateTime
  accountId     String?
  splitMode     String   // EQUAL|PERCENT|INCOME_RATIO|FIXED
  splitConfig   Json
  categoryName  String   @default("Bills & Utilities")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  charges   BillCharge[]

  @@index([householdId, active])
}

model BillCharge {
  id            String   @id @default(cuid())
  sharedBillId  String
  householdId   String
  paidByUserId  String?
  amount        Float
  dueDate       DateTime
  status        String   @default("UPCOMING") // UPCOMING|PAID|MISSED
  paidAt        DateTime?
  transactionId String?
  createdAt     DateTime @default(now())

  sharedBill SharedBill @relation(fields: [sharedBillId], references: [id], onDelete: Cascade)
  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ledger     LedgerEntry[]

  @@index([householdId, status, dueDate])
  @@unique([sharedBillId, dueDate])
}

model LedgerEntry {
  id            String   @id @default(cuid())
  householdId   String
  fromUserId    String
  toUserId      String
  amount        Float
  reason        String
  billChargeId  String?
  settlementId  String?
  createdAt     DateTime @default(now())

  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  billCharge  BillCharge? @relation(fields: [billChargeId], references: [id], onDelete: SetNull)
  settlement  Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
}

model Settlement {
  id            String   @id @default(cuid())
  householdId   String
  fromUserId    String
  toUserId      String
  amount        Float
  transactionId String?
  note          String?
  settledAt     DateTime @default(now())

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]

  @@index([householdId, settledAt])
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  userId      String?
  role        String    @default("MEMBER")
  joinedAt    DateTime?
  inviteEmail String?
  accepted    Boolean   @default(false)
  declined    Boolean   @default(false)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@unique([householdId, inviteEmail])
  @@index([userId])
}

model AccountShare {
  id           String   @id @default(cuid())
  householdId  String
  accountId    String
  ownerUserId  String
  level        String   @default("HIDDEN")
  updatedAt    DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([householdId, accountId])
  @@index([householdId])
}

model Pact {
  id                    String   @id @default(cuid())
  householdId           String   @unique
  version               Int      @default(1)
  bigPurchaseThreshold  Float    @default(250)
  emergencyFundFloor    Float    @default(0)
  savingsRateMin        Int      @default(0)
  personalAllowanceA    Float    @default(0)
  personalAllowanceB    Float    @default(0)
  requireDualSignOff    Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  household  Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  signatures PactSignature[]
}

model PactSignature {
  id       String   @id @default(cuid())
  pactId   String
  userId   String
  version  Int
  signedAt DateTime @default(now())

  pact Pact @relation(fields: [pactId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pactId, userId, version])
}

model MoneyDate {
  id           String    @id @default(cuid())
  householdId  String
  scheduledAt  DateTime
  durationMin  Int       @default(30)
  cadence      String    @default("WEEKLY")
  status       String    @default("UPCOMING")
  agenda       Json?
  completedAt  DateTime?
  decisions    Json?
  createdAt    DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, scheduledAt])
}

model PurchaseReview {
  id              String    @id @default(cuid())
  householdId     String
  transactionId   String    @unique
  requesterUserId String
  amount          Float
  approverUserId  String
  status          String    @default("PENDING")
  reason          String?
  decidedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  requester  User      @relation("ReviewRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  approver   User      @relation("ReviewApprover", fields: [approverUserId], references: [id], onDelete: Cascade)

  @@index([householdId, status])
}

model AllowanceLedger {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  month       String
  allocated   Float
  spent       Float    @default(0)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId, month])
}

model Duel {
  id                       String    @id @default(cuid())
  creatorUserId            String
  title                    String
  mode                     String    @default("DUEL")
  goalId                   String?
  targetAmount             Float
  sprintLengthDays         Int
  startDate                DateTime
  endDate                  DateTime
  status                   String    @default("PENDING")
  stakeText                String
  stakeAmount              Float?
  stakePercentCap          Int?      @default(10)
  isPractice               Boolean   @default(false)
  autoPenaltyEnabled       Boolean   @default(false)
  stakeVoided              Boolean   @default(false)
  stakeResolvedAt          DateTime?
  dailyCap                 Float     @default(500)
  practiceOpponentDailyAvg Float?
  createdAt                DateTime  @default(now())
  completedAt              DateTime?

  creator User         @relation("DuelCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  players DuelPlayer[]
  sprints Sprint[]
  cheers  Cheer[]
  events  DuelEvent[]

  @@index([creatorUserId, status])
}

model DuelPlayer {
  id                String    @id @default(cuid())
  duelId            String
  userId            String?
  inviteEmail       String?
  side              String
  accepted          Boolean   @default(false)
  declined          Boolean   @default(false)
  stakeAccountId    String?
  totalPoints       Float     @default(0)
  sprintsWon        Int       @default(0)
  currentStreakDays Int       @default(0)
  longestStreakDays Int       @default(0)
  joinedAt          DateTime?

  duel          Duel           @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  contributions Contribution[]
  sprintTargets SprintTarget[]
  cheers        Cheer[]

  @@unique([duelId, side])
  @@index([userId])
}

model Sprint {
  id              String    @id @default(cuid())
  duelId          String
  weekNumber      Int
  startDate       DateTime
  endDate         DateTime
  status          String    @default("ACTIVE")
  themeMultiplier Float     @default(1.0)
  themeLabel      String?
  winnerPlayerId  String?
  closedAt        DateTime?

  duel          Duel           @relation(fields: [duelId], references: [id], onDelete: Cascade)
  targets       SprintTarget[]
  contributions Contribution[]

  @@unique([duelId, weekNumber])
  @@index([duelId, startDate])
}

model SprintTarget {
  id       String   @id @default(cuid())
  sprintId String
  playerId String
  amount   Float
  setAt    DateTime @default(now())

  sprint Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  player DuelPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([sprintId, playerId])
}

model Contribution {
  id            String   @id @default(cuid())
  sprintId      String
  playerId      String
  amount        Float
  note          String?
  pointsAwarded Float    @default(0)
  disputeStatus String?
  editableUntil DateTime
  createdAt     DateTime @default(now())

  sprint  Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  player  DuelPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  dispute Dispute?

  @@index([sprintId, playerId])
  @@index([sprintId, createdAt])
}

model Dispute {
  id               String    @id @default(cuid())
  contributionId   String    @unique
  raisedByPlayerId String
  reason           String?
  status           String    @default("PENDING")
  resolvedAt       DateTime?
  autoResolveAt    DateTime
  createdAt        DateTime  @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
}

model Cheer {
  id           String   @id @default(cuid())
  duelId       String
  fromPlayerId String
  sticker      String
  createdAt    DateTime @default(now())

  duel       Duel       @relation(fields: [duelId], references: [id], onDelete: Cascade)
  fromPlayer DuelPlayer @relation(fields: [fromPlayerId], references: [id], onDelete: Cascade)

  @@index([duelId, createdAt])
}

model DuelEvent {
  id        String   @id @default(cuid())
  duelId    String
  kind      String
  playerId  String?
  payload   Json?
  createdAt DateTime @default(now())

  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)

  @@index([duelId, createdAt])
}

model Rule {
  id         String   @id @default(cuid())
  userId     String
  name       String
  pattern    String
  accountId  String?
  categoryOut String
  autoTag    String?
  priority   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priority])
}

model GoalContribution {
  id            String   @id @default(cuid())
  userId        String
  goalId        String
  amount        Float
  date          DateTime
  transactionId String?
  note          String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String
  link      String?
  key       String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@unique([userId, key])
}

model Holding {
  id         String   @id @default(cuid())
  userId     String
  accountId  String
  symbol     String
  shares     Float
  costBasis  Float
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PriceQuote {
  symbol String   @id
  price  Float
  asOf   DateTime
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String
  balance   Float    @default(0)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurring    RecurringTransaction[]
  holdings     Holding[]
  shares       AccountShare[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  amount      Float
  type        String
  category    String
  description String
  date        DateTime
  pending     Boolean  @default(false)
  reviewId    String?
  createdAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String
  limit     Float
  month     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NetWorthSnapshot {
  id     String   @id @default(cuid())
  userId String
  date   DateTime
  value  Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model RecurringTransaction {
  id            String   @id @default(cuid())
  userId        String
  accountId     String
  amount        Float
  type          String
  category      String
  description   String
  frequency     String
  nextRunDate   DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  icon        String
  xp          Int
  category    String
  tier        Int    @default(1)
}

model UserAchievement {
  id              String   @id @default(cuid())
  userId          String
  achievementSlug String
  unlockedAt      DateTime @default(now())
  progress        Float    @default(0)
  completed       Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementSlug])
  @@index([userId])
}

model Category {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String
  icon   String
  kind   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}
