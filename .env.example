# --- REQUIRED -----------------------------------------------------------
# Pooled Postgres connection string. Vercel/Supabase/Neon all support this.
DATABASE_URL="postgresql://user:pass@host:5432/finance_wars?schema=public"
# Direct (non-pooled) connection for Prisma migrations/db push.
DIRECT_URL="postgresql://user:pass@host:5432/finance_wars?schema=public"

# JWT signing secret. App THROWS on boot in production if unset.
# Generate one with: openssl rand -hex 32
JWT_SECRET=""

# --- TESTING ------------------------------------------------------------
# Database for the integration suite (npm run test:integration). Created and
# migrated automatically; truncated between test files, so point it at a
# throwaway database — never at anything you care about.
TEST_DATABASE_URL="postgresql://user:pass@localhost:5432/debtsucker_test"

# --- CRONS --------------------------------------------------------------
# Bearer token that Vercel cron jobs send. Required in production.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- OPTIONAL: Google OAuth --------------------------------------------
# Leave blank to keep email/password auth only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- RECOMMENDED -------------------------------------------------------
# Public base URL. Used to derive OAuth redirect, share links, etc.
# e.g. https://debtsucker.app or http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OPTIONAL: Admin/dev tooling ---------------------------------------
# Token for /api/admin/seed (dev only).
SEED_TOKEN=""

# --- OPTIONAL: Billing (Stripe) -----------------------------------------
# Leave all of these unset to run in "dev mode": upgrading a household's
# plan (Rhythm / Household HQ) happens instantly with no real charge, so
# the whole paywall is testable before you have a Stripe account. See
# lib/billing.ts. Once you're ready to charge for real:
#   1. Create a Stripe account, add two recurring Prices (Rhythm $1/mo,
#      Household HQ $20/mo), and copy their price ids below.
#   2. Set STRIPE_SECRET_KEY from the Stripe dashboard.
#   3. Add a webhook endpoint at <NEXT_PUBLIC_APP_URL>/api/billing/webhook
#      listening for checkout.session.completed, customer.subscription.updated,
#      and customer.subscription.deleted, then copy its signing secret below.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_RHYTHM=""
STRIPE_PRICE_HOUSEHOLD_HQ=""
