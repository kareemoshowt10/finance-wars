# --- REQUIRED -----------------------------------------------------------
# Pooled Postgres connection string. Vercel/Supabase/Neon all support this.
DATABASE_URL="postgresql://user:pass@host:5432/finance_wars?schema=public"
# Direct (non-pooled) connection for Prisma migrations/db push.
DIRECT_URL="postgresql://user:pass@host:5432/finance_wars?schema=public"

# JWT signing secret. App THROWS on boot in production if unset.
# Generate one with: openssl rand -hex 32
JWT_SECRET=""

# --- CRONS --------------------------------------------------------------
# Bearer token that Vercel cron jobs send. Required in production.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- OPTIONAL: Google OAuth --------------------------------------------
# Leave blank to keep email/password auth only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- RECOMMENDED -------------------------------------------------------
# Public base URL. Used to derive OAuth redirect, share links, etc.
# e.g. https://financewars.app or http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OPTIONAL: Admin/dev tooling ---------------------------------------
# Token for /api/admin/seed (dev only).
SEED_TOKEN=""
